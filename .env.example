BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
DATABASE_URL=sqlite+aiosqlite:///data/novabot.db
LOG_LEVEL=INFO

# Optional: dedicated secret for encrypting OAuth tokens at rest.
# If unset, BOT_TOKEN is used to derive the Fernet key.
# OAUTH_TOKEN_SECRET=replace-with-a-long-random-string

# Optional: path to an extra PEM file with custom CA certificates
# SSL_CA_BUNDLE=C:/path/to/custom-ca-bundle.pem
