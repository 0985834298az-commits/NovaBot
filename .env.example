BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
DATABASE_URL=sqlite+aiosqlite:///data/novabot.db
LOG_LEVEL=INFO

# Optional: dedicated Nova Poshta API key for resolving sender refs at startup
# NOVA_POSHTA_API_KEY=your_nova_poshta_api_key_here

# Optional: path to an extra PEM file with custom CA certificates
# SSL_CA_BUNDLE=C:/path/to/custom-ca-bundle.pem
